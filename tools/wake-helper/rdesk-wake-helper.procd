#!/bin/sh /etc/rc.common
# Only for an already supported OpenWrt installation. Not a MiWiFi .mpk package.
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/rdesk-wake-helper run --state /etc/rdesk-wake-helper
    # Retry indefinitely at 30-second intervals; each start revalidates the
    # enrolled LAN. A prolonged link outage must not exhaust recovery attempts.
    procd_set_param respawn 3600 30 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
