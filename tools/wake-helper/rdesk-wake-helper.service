[Unit]
Description=RDesk LAN wake helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Bind-to-device needs CAP_NET_RAW; the daemon never opens an inbound TCP port.
ExecStart=/usr/local/bin/rdesk-wake-helper run --state /var/lib/rdesk-wake-helper
User=root
UMask=0077
StateDirectory=rdesk-wake-helper
StateDirectoryMode=0700
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/rdesk-wake-helper

[Install]
WantedBy=multi-user.target
